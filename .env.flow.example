# ============================================
# CONFIGURACIÓN DE FLOW - PASARELA DE PAGOS
# ============================================

# Modo de operación
# Valores: sandbox (pruebas) o production (producción)
FLOW_MODE=sandbox

# Credenciales de Flow
# Obtén estas credenciales en: https://www.flow.cl/app/web/comercio.php
FLOW_API_KEY=tu_api_key_aqui
FLOW_SECRET_KEY=tu_secret_key_aqui

# URL de tu aplicación (para callbacks)
# Asegúrate de que esta URL sea accesible públicamente para recibir las notificaciones de Flow
APP_URL=http://localhost

# ============================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ============================================

# 1. Copia este archivo a .env (si no existe) o agrega estas variables a tu archivo .env existente
# 2. Regístrate en Flow: https://www.flow.cl/
# 3. Accede a tu panel de Flow y obtén tus credenciales:
#    - API Key
#    - Secret Key
# 4. Para pruebas, usa FLOW_MODE=sandbox
# 5. Para producción, usa FLOW_MODE=production y actualiza las credenciales

# ============================================
# TARJETAS DE PRUEBA (MODO SANDBOX)
# ============================================

# Visa (Aprobada):
#   Número: 4513 1200 7678 9283
#   CVV: 123
#   Fecha: Cualquier fecha futura

# Mastercard (Rechazada):
#   Número: 5475 4420 7069 5441
#   CVV: 123
#   Fecha: Cualquier fecha futura

# ============================================
# IMPORTANTE
# ============================================

# - Los callbacks de Flow (confirmar y retorno) deben ser accesibles públicamente
# - Si estás en desarrollo local, usa ngrok o similar para exponer tu servidor
# - Ejemplo con ngrok: ngrok http 80
# - Luego actualiza APP_URL con la URL de ngrok
